rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ngash@barbershop.local' ||
        request.auth.token.email == 'jay@barbershop.local'
      );
    }

    // User profiles keyed by email address.
    match /userProfiles/{email} {
      allow read: if isSignedIn() && request.auth.token.email == email;
      allow write: if isAdmin();
    }

    // Holiday cache (managed by Cloud Functions)
    match /holidayCache/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Day data (written by Cloud Functions only)
    match /days/{dayKey} {
      allow read: if isSignedIn();
      allow write: if false;

      match /attendance/{id} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /transactions/{id} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Optional app settings (admin managed)
    match /appSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}

